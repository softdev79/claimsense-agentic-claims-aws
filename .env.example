# Copy this file to .env and put your real values in it. Never commit .env to git.
# AWS capstone edition: Amazon Bedrock through its OpenAI-compatible endpoint.
OPENAI_API_KEY=your-bedrock-api-key
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
OPENAI_PROJECT_ID=your-project-id
# Optional overrides
# OPENAI_MODEL=qwen.qwen3-vl-235b-a22b-instruct     (cheaper alternative: mistral.ministral-3-14b-instruct)
# USD_TO_INR=88

# Email for AWS Budget alerts (read by deploy\deploy.ps1)
# BUDGET_EMAIL=you@example.com
